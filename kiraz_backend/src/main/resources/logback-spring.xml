<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 1. Renkli ve Okunaklı Konsol Appender (ConsoleAppender) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%yellow(%thread)] %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2. Asenkron Logstash TCP Socket Appender (LogstashTcpSocketAppender -> localhost:5000) -->
    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>localhost:5000</destination>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app_name":"kiraz-backend","service":"kiraz_backend"}</customFields>
        </encoder>
        <reconnectionDelay>10 seconds</reconnectionDelay>
    </appender>

    <!-- Root Logger: Hem konsola hem Logstash'e iletir -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH" />
    </root>

    <!-- Uygulama içi log seviyeleri -->
    <logger name="com.ars.kirazbackend" level="DEBUG" />
    <logger name="org.springframework.kafka" level="INFO" />
    <logger name="org.apache.kafka" level="WARN" />

</configuration>
